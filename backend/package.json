{
  "name": "xwz-parking-system-backend",
  "version": "2.0.0",
  "description": "Microservices backend for XWZ LTD Parking Management System",
  "private": true,
  "main": "services/api-gateway/src/server.ts",
  "scripts": {
    "dev:gateway": "node init && ts-node-dev --respawn --transpile-only services/api-gateway/src/server.ts",
    "dev:auth": "node init && ts-node-dev --respawn --transpile-only services/auth-service/src/server.ts",
    "dev:parking": "node init && ts-node-dev --respawn --transpile-only services/parking-service/src/server.ts",
    "dev:car": "node init && ts-node-dev --respawn --transpile-only services/car-service/src/server.ts",
    "dev:report": "node init && ts-node-dev --respawn --transpile-only services/report-service/src/server.ts",
    "dev:all": "node init && concurrently \"npm run dev:auth\" \"npm run dev:parking\" \"npm run dev:car\" \"npm run dev:report\" \"npm run dev:gateway\"",
    "build": "node init && tsc -p tsconfig.json",
    "start": "node init && node dist/services/api-gateway/src/server.js",
    "seed:admin": "ts-node --files scripts/seed-admin.ts"
  },
  "dependencies": {
    "axios": "^1.8.4",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-validator": "^7.2.1",
    "http-proxy-middleware": "^3.0.3",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "nodemailer": "^6.10.1",
    "pg": "^8.13.3",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.5",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.13.14",
    "@types/nodemailer": "^8.0.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "concurrently": "^9.1.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.3"
  }
}
